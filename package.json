{
  "name": "botc_webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "add-revision": "node scripts/add-character-revision.mjs",
    "build-embeddings": "node scripts/build-embeddings.mjs",
    "build-wiki": "node scripts/build-wiki.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:check:strict": "node scripts/i18n-check.mjs --strict",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "verify": "node scripts/verify.mjs",
    "dev": "vite",
    "build": "node scripts/validate-revisions.mjs && tsc -b && vite build",
    "build:native": "node scripts/validate-revisions.mjs && tsc -b && vite build --mode native",
    "cap:sync": "npm run build:native && npx cap sync",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=mobile-android",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:ui": "vitest --ui",
    "electron:dev": "npm run build:native && electron .",
    "electron:build": "npm run build:native && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "npm run build:native && electron-builder --mac --config electron-builder.config.cjs",
    "dist:mac:x64": "npm run build:native && electron-builder --mac --x64 --config electron-builder.config.cjs",
    "dist:mac:arm64": "npm run build:native && electron-builder --mac --arm64 --config electron-builder.config.cjs",
    "android:build": "npm run build:native && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "release": "node scripts/github-release.mjs",
    "release:update": "node scripts/github-release.mjs",
    "release:create": "node scripts/github-release.mjs --create"
  },
  "dependencies": {
    "@byteowls/capacitor-oauth2": "^5.0.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@types/react-window": "^1.8.8",
    "firebase": "^12.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-window": "^1.8.11"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.2",
    "puppeteer": "^24.40.0",
    "typescript": "^5.8.2",
    "vconsole": "^3.15.1",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5"
  }
}
