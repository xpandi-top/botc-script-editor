# Copy this file to .env.local and fill in values for local development.
# .env.local is gitignored — never commit real credentials.

# Google Drive sync
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# Firebase (Firestore short links)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Deployed app URL — used for share links (short links point here).
# Leave blank for local dev (short links are skipped on localhost anyway).
# Example: https://botccompanion.web.app
VITE_APP_URL=

# AI agent
# Provider: groq (free, recommended) | openrouter (free models) | gemini
VITE_AI_PROVIDER=groq
# Get Groq key free: https://console.groq.com
# Get OpenRouter key free: https://openrouter.ai
# Get Gemini key: https://aistudio.google.com/app/apikey
VITE_AI_API_KEY=
VITE_GEMINI_API_KEY=
