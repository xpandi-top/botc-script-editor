{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botc-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Web app the share links open. Must match the deployed Pages URL.
    "APP_URL": "https://xpandi-top.github.io/botc-script-editor/",
    // Optional: Firestore project + web API key (public client config) to
    // create 7-character ?ss= short links. Leave empty to return inline links.
    "FIREBASE_PROJECT_ID": "",
    "FIREBASE_API_KEY": ""
  }
}
