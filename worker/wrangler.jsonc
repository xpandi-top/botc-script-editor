{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "botc-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// P3 cloud games: one SQLite-backed Durable Object per game (free plan).
	"durable_objects": {
		"bindings": [
			{
				"name": "GAMES",
				"class_name": "GameRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GameRoom"
			]
		}
	],
	"vars": {
		// Web app the share links open. Must match the deployed Pages URL.
		"APP_URL": "https://apps.xpandi.top/botc-script-editor/",
		// Optional: Firestore project + web API key (public client config) to
		// create 7-character ?ss= short links. Leave empty to return inline links.
		"FIREBASE_PROJECT_ID": "",
		"FIREBASE_API_KEY": "",
		// Optional OAuth token proxy for the web app (docs/ISSUES.md I-73). Also run
		// `npx wrangler secret put GOOGLE_CLIENT_SECRET`.
		"GOOGLE_WEB_CLIENT_ID": "401513017527-11mrpj9kf8g0f0igu66qk58c1ksiapvn.apps.googleusercontent.com",
		"OAUTH_ALLOWED_ORIGINS": "https://xpandi-top.github.io,http://localhost:5173,https://apps.xpandi.top",
		// Other Google OAuth client ids (Android, Electron) allowed to sign in to /v1/me.
		"GOOGLE_CLIENT_IDS": "",
		// P5 hosted AI (Workers AI free tier: 10k neurons/day). Models are tested
		// choices (docs/ARCHITECTURE-API.md §7.5); limits are chat requests per UTC day.
		"AI_CHAT_MODEL": "@cf/zai-org/glm-4.7-flash",
		"AI_EMBED_MODEL": "@cf/baai/bge-m3",
		"AI_DAILY_LIMIT": "300",
		"AI_DAILY_LIMIT_PER_IP": "30",
		"AI_DAILY_LIMIT_PER_USER": "100",
		// Workers AI neurons hosted chat may use per day (free plan: 10,000 in total).
		"AI_DAILY_NEURONS": "8000"
	},
	// P5 hosted AI + character embeddings. Always runs remotely, also in `wrangler dev`.
	"ai": {
		"binding": "AI",
		"remote": true
	},
	// P2 cloud library (code reads env.DB). Apply the schema with
	// `npx wrangler d1 migrations apply botc-library --remote`.
	// "remote": true makes `wrangler dev` use this production database too.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "botc-library",
			"database_id": "a083f6b4-eaad-46b6-846c-d5698a8d1d5a",
			"migrations_dir": "migrations",
			"remote": true
		}
	]
}