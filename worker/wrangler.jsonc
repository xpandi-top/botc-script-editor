{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botc-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // P3 cloud games: one SQLite-backed Durable Object per game (free plan).
  "durable_objects": { "bindings": [{ "name": "GAMES", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // P2 cloud library. Create once with `npx wrangler d1 create botc-library`,
  // paste the printed database_id below, uncomment, then
  // `npx wrangler d1 migrations apply botc-library --remote`.
  // Without it /v1/me answers 503 and MCP stays read-only.
  // "d1_databases": [{ "binding": "DB", "database_name": "botc-library", "database_id": "<paste id>", "migrations_dir": "migrations" }],
  "vars": {
    // Web app the share links open. Must match the deployed Pages URL.
    "APP_URL": "https://xpandi-top.github.io/botc-script-editor/",
    // Optional: Firestore project + web API key (public client config) to
    // create 7-character ?ss= short links. Leave empty to return inline links.
    "FIREBASE_PROJECT_ID": "",
    "FIREBASE_API_KEY": "",
    // Optional OAuth token proxy for the web app (docs/ISSUES.md I-73). Also run
    // `npx wrangler secret put GOOGLE_CLIENT_SECRET`.
    "GOOGLE_WEB_CLIENT_ID": "",
    "OAUTH_ALLOWED_ORIGINS": "https://xpandi-top.github.io,http://localhost:5173",
    // Other Google OAuth client ids (Android, Electron) allowed to sign in to /v1/me.
    "GOOGLE_CLIENT_IDS": ""
  }
}
